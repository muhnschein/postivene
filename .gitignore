# Rust
/target/
**/target/
Cargo.lock.bak
# `cargo vendor` output, generated locally for offline builds inside the
# Sailfish SDK chroot (scratchbox2 has no reliable network path to
# crates.io in this environment) -- see docs/MILESTONES.md milestone 6
/rust/vendor/
/rust/.cargo/

# Sailfish SDK / mb2 / sfdk build artifacts
RPMS/
*.rpm
build-*/
*.spec.bak

# Qt Creator / QML tooling
*.pro.user
*.pro.user.*
.qmake.stash

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store

# deltachat-rpc-server binaries fetched by scripts/fetch-rpc-server.sh
# (or cross-compiled) -- see vendor/deltachat-rpc-server/SOURCE.md
/vendor/deltachat-rpc-server/*/
