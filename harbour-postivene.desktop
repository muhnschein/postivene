[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-postivene
Exec=harbour-postivene
Name=Postivene
Name[fi]=Postivene
Comment=Delta Chat client
Categories=Network;InstantMessaging;

# Sailjail confines the app to $HOME/.local/share/<Org>/<App> (and the
# .cache and .config equivalents). Without this section a relaxed default
# profile applies instead, which is what the app ran under until now.
#
# Internet, for the core's own traffic; everything else it does happens
# inside its own account directory.
#
# Pictures and MediaIndexing are both needed by the settings page's
# profile picture, and neither is sufficient alone: Pictures whitelists
# ~/Pictures and the Android storage equivalents, while MediaIndexing
# grants `dbus-user.talk org.freedesktop.Tracker3.Miner.Files` -- the
# index the gallery picker actually lists from. With only Pictures the
# picker can read the files and cannot find them, which is why it came up
# empty on a device.
#
# UserDirs is what the attach button needs: Silica's pickers run inside
# this process, so a file the sandbox does not grant is one the app cannot
# read however it was chosen. It covers the XDG user directories --
# Documents, Downloads, Music, Videos -- in one permission rather than
# four, which is also what harbour-whisperfish declares for its own
# attachment picker. Pictures is kept beside it because it is not certain
# from the outside that UserDirs subsumes it, and this is the grant the
# profile picture was found to need on a real device.
#
# Audio is for playing a voice message or a sound file in the conversation,
# which goes through PulseAudio. Nothing here records: QML has no audio
# recorder on Qt 5.6, so Microphone stays off until there is something to
# use it.
#
# Camera is for the QR scanner: an invite or a chatmail server code held
# up to the phone. ScanPage.qml is the only file that opens it, and only
# while it is the page on screen.
[X-Sailjail]
Permissions=Internet;Pictures;MediaIndexing;UserDirs;Audio;Camera
OrganizationName=postivene
ApplicationName=postivene
