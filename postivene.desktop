[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=postivene
Exec=postivene
Name=Postivene
Name[fi]=Postivene
Comment=Delta Chat client
Categories=Network;InstantMessaging;

# Sailjail confines the app to $HOME/.local/share/<Org>/<App> (and the
# .cache and .config equivalents). Without this section a relaxed default
# profile applies instead, which is what the app ran under until now.
#
# Internet, for the core's own traffic; everything else it does happens
# inside its own account directory. Pictures, because the settings page
# picks a profile picture out of the gallery: without it the picker shows
# an empty folder and the file it hands back cannot be opened.
#
# Camera belongs here too once QR scanning lands, and not before -- a
# permission the app does not use is a sandbox hole for no benefit.
[X-Sailjail]
Permissions=Internet;Pictures
OrganizationName=postivene
ApplicationName=postivene
